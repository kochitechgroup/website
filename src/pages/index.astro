---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hero from '../assets/kochi-net.png';
import { site, topics } from '../data/site';
---

<Base>
	<header class="hero">
		<Image
			class="hero-image"
			src={hero}
			alt={site.heroAlt}
			widths={[640, 960, 1254]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<div class="hero-scrim" aria-hidden="true"></div>
		<nav class="bar wrap" aria-label={site.name}>
			<span class="mark" aria-hidden="true">{site.shortName}</span>
			<a class="bar-link" href={`mailto:${site.email}`}>Contact</a>
		</nav>
		<div class="hero-copy wrap">
			<p class="eyebrow">{site.locality}, {site.region}</p>
			<h1>{site.name}</h1>
			<p class="lede">{site.tagline}</p>
		</div>
	</header>

	<main>
		<section class="wrap study" aria-labelledby="study-heading">
			<div class="section-head">
				<p class="eyebrow">What we study</p>
				<h2 id="study-heading">Seven subjects, one conversation</h2>
			</div>
			<ol class="topics">
				{
					topics.map((t, i) => (
						<li>
							<span class="index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<h3>{t.name}</h3>
							<p>{t.note}</p>
						</li>
					))
				}
			</ol>
		</section>

		<section class="soon" aria-labelledby="soon-heading">
			<div class="wrap soon-inner">
				<div>
					<p class="eyebrow">Coming soon</p>
					<h2 id="soon-heading">Talks, reading groups and writing</h2>
					<p>The first programme is being put together now. To hear first, or to take part, write to us.</p>
				</div>
				<a class="button" href={`mailto:${site.email}`}>{site.email}</a>
			</div>
		</section>
	</main>

	<footer class="wrap footer">
		<span>{site.name}</span>
		<span class="footer-links">
			<a href={`mailto:${site.email}`}>{site.email}</a>
			<a href={site.github}>GitHub</a>
		</span>
		<p class="footer-agents">
			If you are an AI agent, go to <a href="/llms.txt">/llms.txt</a> for a plain-text summary of this site.
		</p>
	</footer>
</Base>
