---
const email = 'hello@kochitechgroup.dev';
const github = 'https://github.com/kochitechgroup';
const topics = [
	'Systems programming',
	'Enterprise computing',
	'Machine learning',
	'Statistics',
	'Deep learning',
	'Mathematics',
	'Philosophy',
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Kochi Tech Group</title>
		<meta
			name="description"
			content="A not-for-profit community in Kochi for systems programming, enterprise computing, machine learning, statistics, deep learning, mathematics and philosophy."
		/>
	</head>
	<body>
		<main>
			<header>
				<p class="mark">KTG</p>
				<h1>Kochi Tech Group</h1>
				<p class="lede">
					A not-for-profit community in Kochi for people who want to understand computing properly,
					from the machine up and from first principles down.
				</p>
			</header>

			<section>
				<h2>What we study</h2>
				<ul class="topics">
					{topics.map((t) => <li>{t}</li>)}
				</ul>
			</section>

			<section class="join">
				<h2>Coming soon</h2>
				<p>
					Talks, reading groups and writing are in the works. To hear first, or to take part, write
					to us.
				</p>
				<p><a class="button" href={`mailto:${email}`}>{email}</a></p>
			</section>

			<footer>
				<a href={github}>GitHub</a>
				<span>Kochi, Kerala</span>
			</footer>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--bg: #fbfaf7;
		--fg: #1b1d1f;
		--muted: #5c6166;
		--rule: #e3e0d8;
		--accent: #0f766e;
		--accent-fg: #ffffff;
		color-scheme: light dark;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #121416;
			--fg: #e8e6e1;
			--muted: #9aa0a6;
			--rule: #2a2e33;
			--accent: #2dd4bf;
			--accent-fg: #0b1412;
		}
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font: 17px/1.6 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
	}
	main {
		max-width: 44rem;
		margin: 0 auto;
		padding: 4rem 1rem 3rem;
	}
	.mark {
		display: inline-block;
		margin: 0 0 1.5rem;
		padding: 0.2rem 0.5rem;
		border: 2px solid var(--accent);
		color: var(--accent);
		font: 700 0.85rem/1 ui-monospace, 'Cascadia Code', Menlo, monospace;
		letter-spacing: 0.1em;
	}
	h1 {
		margin: 0;
		font-size: clamp(2.2rem, 7vw, 3.4rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.lede {
		margin: 1rem 0 0;
		font-size: 1.2rem;
		color: var(--muted);
	}
	section {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--rule);
	}
	h2 {
		margin: 0 0 1rem;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--muted);
	}
	.topics {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.topics li {
		padding: 0.35rem 0.8rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
	}
	.button {
		display: inline-block;
		padding: 0.7rem 1.1rem;
		background: var(--accent);
		color: var(--accent-fg);
		text-decoration: none;
		font-weight: 600;
		border-radius: 6px;
		overflow-wrap: anywhere;
	}
	.button:hover {
		filter: brightness(1.08);
	}
	footer {
		margin-top: 4rem;
		display: flex;
		justify-content: space-between;
		font-size: 0.9rem;
		color: var(--muted);
	}
	footer a {
		color: inherit;
	}
</style>
