---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title={`Page not found | ${site.name}`} description="This page does not exist." noindex>
	<main class="wrap not-found">
		<p class="eyebrow">404</p>
		<h1>This page does not exist</h1>
		<p>It may have moved, or it was never here. The site is small for now.</p>
		<p><a class="button" href="/">Go to the home page</a></p>
	</main>
</Base>

<style>
	.not-found {
		min-height: 70vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-top: 4rem;
		padding-bottom: 4rem;
	}
	.not-found h1 {
		font-size: clamp(2rem, 6vw, 3.2rem);
		line-height: 1.1;
	}
	.not-found p {
		color: var(--muted);
	}
</style>
