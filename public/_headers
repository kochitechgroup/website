# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/

# Content-hashed build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/index.html.md
  Content-Type: text/markdown; charset=utf-8

# Bluesky domain handle verification (@kochitechgroup.dev). Must be plain text.
/.well-known/atproto-did
  Content-Type: text/plain; charset=utf-8
